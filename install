#!/usr/bin/env bash
set -euo pipefail

for cmd in git stow; do
  if ! command -v "$cmd" >/dev/null; then
    printf '===> ERROR: %s\n' "Command '$cmd' is missing!" >&2
    exit 1
  fi
done

packages=(bash bun git)

cd -- "$HOME/dotfiles"
stow -v --no-folding -t "$HOME" --adopt "${packages[@]}"
git restore .
