# Entry point sourced by interactive zsh (from ~/.zshrc).
# Shared definitions live in shell/*.sh (loaded via shell/load.sh).

_dotfiles_bootstrap() {
	local self root link
	# zsh: %x = path of this file when sourced
	# shellcheck disable=SC2296
	self="${(%):-%x}"
	# Resolve one level of symlink (install.sh links ~/.zsh_aliases -> repo).
	if [[ -L "$self" ]]; then
		link="$(readlink "$self")"
		case "$link" in
		/*) self="$link" ;;
		*) self="$(dirname "$self")/${link}" ;;
		esac
	fi
	root="$(cd "$(dirname "$self")" && pwd -P)"
	# shellcheck source=/dev/null
	source "${root}/shell/load.sh"
}

_dotfiles_bootstrap
unset -f _dotfiles_bootstrap
