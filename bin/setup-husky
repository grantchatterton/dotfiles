#!/usr/bin/env bash
set -euo pipefail

for dep in jq; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    echo "$dep could not be found" >&2
    exit 1
  fi
done

dir="${1:-.}"
dir="$(cd -- "$dir" && pwd)"
pkg="$dir/package.json"

if [[ ! -f "$pkg" ]]; then
  echo "package.json not found in $dir" >&2
  exit 1
fi

cd -- "$dir"

detect_pm() {
  if [[ -f pnpm-lock.yaml ]] && command -v pnpm >/dev/null 2>&1; then
    echo pnpm
  elif [[ -f yarn.lock ]] && command -v yarn >/dev/null 2>&1; then
    echo yarn
  elif { [[ -f bun.lockb ]] || [[ -f bun.lock ]]; } && command -v bun >/dev/null 2>&1; then
    echo bun
  elif command -v npm >/dev/null 2>&1; then
    echo npm
  else
    echo "no package manager found (npm/pnpm/yarn/bun)" >&2
    exit 1
  fi
}

pm="$(detect_pm)"

install_dev() {
  case "$pm" in
    pnpm) pnpm add -D "$@" ;;
    yarn) yarn add -D "$@" ;;
    bun) bun add -d "$@" ;;
    npm) npm install -D "$@" ;;
  esac
}

install_dev husky lint-staged

cmds='[]'
has_dev() {
  jq -e --arg name "$1" '.devDependencies[$name] != null' "$pkg" >/dev/null 2>&1
}

if has_dev biome; then
  cmds="$(jq -c '. + ["biome check --write --no-errors-on-unmatched"]' <<<"$cmds")"
fi
if has_dev oxlint; then
  cmds="$(jq -c '. + ["oxlint --fix --no-error-on-unmatched-pattern"]' <<<"$cmds")"
fi
if has_dev oxfmt; then
  cmds="$(jq -c '. + ["oxfmt --no-error-on-unmatched-pattern"]' <<<"$cmds")"
fi

tmp="$(mktemp)"
jq --argjson cmds "$cmds" '.["lint-staged"] = {"*": $cmds}' "$pkg" >"$tmp"
mv "$tmp" "$pkg"

echo "lint-staged configured in $pkg"
