#!/usr/bin/env bash
set -euo pipefail

# Scaffold a new Bun project from bun-template.
# usage: create-bun [directory]  (defaults to current dir, which must be empty)

repo="https://github.com/grantchatterton/bun-template"

die() {
  echo "error: $*" >&2
  exit 1
}

for cmd in git bun jq; do
  command -v "$cmd" >/dev/null 2>&1 || die "$cmd not found"
done

if [[ "$#" -gt 1 || ( "$#" -eq 1 && -z "$1" ) ]]; then
  echo "usage: create-bun [directory]" >&2
  exit 1
fi

# No arg: scaffold in place. Arg: scaffold into a new directory.
dest="${1:-.}"
if [[ "$#" -eq 0 ]]; then
  [[ -z "$(ls -A)" ]] || die "current directory not empty"
  project_name="$(basename "$PWD")"
else
  [[ ! -e "$dest" ]] || die "$dest already exists"
  project_name="$(basename "$dest")"
fi

# Copy template without its history, then start a fresh repo
git clone --depth 1 "$repo" "$dest"
rm -rf -- "$dest/.git"
git -C "$dest" init

# Rename package to match the project directory
pkg="$dest/package.json"
tmp="$(mktemp)"
jq --arg name "$project_name" '.name = $name' "$pkg" >"$tmp"
mv "$tmp" "$pkg"

# Regenerate lockfile so it reflects the renamed package
rm -f -- "$dest/bun.lock"
bun install --cwd "$dest"

git -C "$dest" add -A
git -C "$dest" commit --no-verify -m "feat: initial commit"
