########################################################
# Stage: Bun
########################################################
FROM docker.io/oven/bun:1.4.4-slim AS bun

########################################################
# Stage: Runner
########################################################
FROM docker.io/library/node:26.13.0-trixie-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates git jq less procps python3 ripgrep \
  && rm -rf /var/lib/apt/lists/*

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s bun /usr/local/bin/bunx

ENV CLAUDE_CONFIG_DIR=/home/node/.claude
RUN install -d -m 700 -o node -g node -- "$CLAUDE_CONFIG_DIR"

ENV NPM_CONFIG_CACHE=/tmp/.npm-cache
ARG CLAUDE_CODE_VERSION=latest
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
  && npm cache clean --force

ENV DISABLE_UPDATES=1

USER node
ENTRYPOINT ["claude"]
