FROM docker.io/library/debian:trixie-slim AS base

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.local/bin:$PATH"

ARG CLAUDE_CODE_VERSION=latest
RUN curl -fsSL https://claude.ai/install.sh | bash -s -- "${CLAUDE_CODE_VERSION}"

FROM docker.io/library/node:26.13.0-trixie-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates git jq ripgrep \
  && rm -rf /var/lib/apt/lists/*

ENV CLAUDE_CONFIG_DIR=/home/node/.claude
RUN mkdir -p "${CLAUDE_CONFIG_DIR}" \
  && chown -R node:node "${CLAUDE_CONFIG_DIR}" \
  && chmod 700 "${CLAUDE_CONFIG_DIR}"

COPY --from=base --chown=root:root --chmod=0755 \
  /root/.local/bin/claude /usr/local/bin/claude

ENV NPM_CONFIG_CACHE=/tmp/.npm-cache
ENV DISABLE_UPDATES=1

USER node

ENTRYPOINT ["claude"]
