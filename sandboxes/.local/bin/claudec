#!/usr/bin/env bash
set -euo pipefail

# Run Claude Code inside a locked-down Podman container, with only the
# current directory (and the Claude config volume) visible to the agent.

SBX_DIR="$HOME/.sandboxes/claude"
SBX_CONTAINERFILE="$SBX_DIR/Containerfile"
SBX_IMAGE_TAG="localhost/sbx-claude"
SBX_AGENT_HOME="/home/node/.claude" # must match CLAUDE_CONFIG_DIR in the Containerfile
SBX_DEFAULT_CPUS=4
SBX_DEFAULT_MEMORY_MB=8192

CLAUDE_SKILLS_DIR="$HOME/.claude/skills"

BUN_CONFIG="$HOME/.bunfig.toml"

die() {
  printf 'claudec: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  claudec build              Build (or rebuild) the sandbox image.
  claudec run [--cpus <n>] [--memory <mb>] [-- <args>]
                             Run the sandbox, building the image if missing.
                             --cpus    CPU limit (default: 4).
                             --memory  Memory limit in MB (default: 8192).
                             Arguments after `--` are passed to `claude`.
EOF
}

# Always builds, so this also picks up Containerfile changes or a newer
# Claude Code release.
build_image() {
  [[ -d "$SBX_DIR" ]] || die "sandbox dir not found: $SBX_DIR"
  [[ -f "$SBX_CONTAINERFILE" ]] || die "containerfile not found: $SBX_CONTAINERFILE"
  podman build -t "$SBX_IMAGE_TAG" -f "$SBX_CONTAINERFILE" -- "$SBX_DIR"
}

cmd_run() {
  local cpus="$SBX_DEFAULT_CPUS"
  local memory_mb="$SBX_DEFAULT_MEMORY_MB"

  # Options come first; everything after `--` belongs to the agent.
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --)
      shift
      break
      ;;
    --cpus)
      [[ $# -ge 2 ]] || die "$1 requires a value"
      # Validate here so a typo fails fast instead of inside podman/krun.
      [[ "$2" =~ ^[1-9][0-9]*$ ]] || die "$1 must be a positive integer, got: $2"
      cpus="$2"
      shift 2
      ;;
    --memory)
      [[ $# -ge 2 ]] || die "$1 requires a value"
      [[ "$2" =~ ^[1-9][0-9]*$ ]] || die "$1 must be a positive integer, got: $2"
      memory_mb="$2"
      shift 2
      ;;
    *) die "unexpected argument: $1 (pass agent args after --)" ;;
    esac
  done

  if ! podman image exists "$SBX_IMAGE_TAG"; then
    build_image
  fi

  # The working directory is bind-mounted read-write at the same path, so
  # refuse locations that would hand the agent far more than a single project.
  local cwd
  cwd="$(pwd -P)"
  if [[ "$cwd" == "/" || "$cwd" == "$(cd "$HOME" && pwd -P)" ]]; then
    die "refusing to mount $cwd into the sandbox; cd into a project first"
  fi

  local -a podman_run_args=(
    --rm
    --interactive
    # Hardening: no privilege escalation, no capabilities, immutable root fs.
    --security-opt no-new-privileges
    --cap-drop all
    --read-only
    --tmpfs "/tmp:rw,nodev,nosuid,mode=1777"
    # Resource limits.
    --cpus "$cpus"
    --memory "${memory_mb}m"
    --pids-limit 1024
    # Map the host user to the same UID inside so files written to the
    # project keep the right ownership.
    --userns keep-id
    --volume "$cwd:$cwd"
    --workdir "$cwd"
    # Named volume persists Claude's config, credentials and history across runs.
    --volume "claude-agent-home:$SBX_AGENT_HOME"
    --env "TERM=${TERM:-xterm-256color}"
    --env "COLORTERM=${COLORTERM:-truecolor}"
  )

  # Only allocate a TTY when attached to a terminal, so piping
  # (e.g. `claudec run -- -p`) still works.
  if [[ -t 0 && -t 1 ]]; then
    podman_run_args+=(--tty)
  fi

  # Prefer a libkrun micro-VM when available for stronger isolation. krun
  # sizes the VM from annotations rather than the cgroup limits above.
  if command -v krun >/dev/null; then
    podman_run_args+=(
      --runtime krun
      --annotation "krun.cpus=$cpus"
      --annotation "krun.ram_mib=$memory_mb"
    )
  fi

  # Forward git identity so commits made in the sandbox are attributed
  # correctly (the host ~/.gitconfig is not mounted).
  local field value
  for field in NAME EMAIL; do
    value="$(git config --global "user.${field,,}" 2>/dev/null || true)"
    if [[ -n "$value" ]]; then
      podman_run_args+=(
        --env "GIT_AUTHOR_$field=$value"
        --env "GIT_COMMITTER_$field=$value"
      )
    fi
  done

  # Share host skills read-only so the agent can use but not modify them.
  if [[ -d "$CLAUDE_SKILLS_DIR" ]]; then
    podman_run_args+=(
      --volume "$CLAUDE_SKILLS_DIR:$SBX_AGENT_HOME/skills:ro"
    )
  fi

  # Mount bun config file (read-only) if present
  if [[ -f "$BUN_CONFIG" ]]; then
    podman_run_args+=(
      --volume "$BUN_CONFIG:/home/node/$(basename -- "$BUN_CONFIG"):ro"
    )
  fi

  exec podman run "${podman_run_args[@]}" "$SBX_IMAGE_TAG" "$@"
}

# Usage: cmd_build
cmd_build() {
  [[ $# -eq 0 ]] || die "build takes no arguments"
  build_image
}

main() {
  local cmd="${1:-run}"
  shift || true

  case "$cmd" in
  build) cmd_build "$@" ;;
  run) cmd_run "$@" ;;
  -h | --help | help) usage ;;
  "")
    usage >&2
    exit 1
    ;;
  *) die "unknown command: $cmd (see claudec --help)" ;;
  esac
}

main "$@"
