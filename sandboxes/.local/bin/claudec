#!/usr/bin/env bash
#
# Run Claude Code inside a locked-down, throwaway Podman container, with the
# current directory mounted at /workspace. All arguments are passed through
# to `claude`, e.g.:
#
#   ./claudec
#   ./claudec --continue
#   ./claudec -p "explain this repo"
#
# Login state and settings persist across runs in the `claude-agent-home`
# named volume; everything else in the container is discarded on exit.
#
# If krun (libkrun) is installed, the container runs inside a lightweight
# micro-VM for an extra isolation boundary beyond namespaces.

set -euo pipefail

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

command -v podman >/dev/null || die 'podman not found'

# Refuse to mount / or the home dir (or any ancestor of it, e.g. /home),
# since that would expose dotfiles, SSH keys, credentials, etc. to the agent.
cwd="$(pwd -P)"
home="$(cd "$HOME" && pwd -P)"
if [[ "$cwd" == / || "$home" == "$cwd" || "$home" == "$cwd"/* ]]; then
  die "refusing to mount $cwd: run from a project directory, not / or your home dir"
fi

# Resource limits. Used both for Podman's cgroup limits and for sizing
# the krun VM, so the two stay in sync.
readonly NUM_CPUS=4
readonly RAM_MB=8192

readonly CLAUDE_IMAGE_TAG="localhost/sbx-claude"
readonly CLAUDE_CONTAINERFILE="$HOME/.sandboxes/claude/Containerfile"

# Build the image only if it doesn't exist yet. Claude Code itself is unpinned,
# so it's frozen at whatever version was current on the first build. To upgrade,
# remove the image (`podman rmi localhost/sbx-claude`) and run again.
#
# The image is Node-based (Claude Code is an npm package) with bun copied in
# so the agent can run bun projects, plus the CLI tools Claude Code shells
# out to for searching and editing.
if ! podman image exists "$CLAUDE_IMAGE_TAG"; then
  [[ -f "$CLAUDE_CONTAINERFILE" ]] || die "Claude container file not found $CLAUDE_CONTAINERFILE"
  podman build -t "$CLAUDE_IMAGE_TAG" -f "$CLAUDE_CONTAINERFILE" -- "$(dirname -- "$(readlink -f -- "$CLAUDE_CONTAINERFILE")")"
fi

extra_args=()

# Only allocate a TTY when we're actually attached to one; forcing --tty
# in pipes/CI (e.g. `claudec -p ... | jq`) corrupts output.
if [[ -t 0 && -t 1 ]]; then
  extra_args+=(--tty)
fi

# Expose the user's global bun config read-only, so bun inside the agent
# uses the same registry settings. /home/node is the home dir of the image's
# `node` user, which --userns=keep-id maps the host user onto (UID 1000).
bunfig="$HOME/.bunfig.toml"
if [[ -f "$bunfig" ]]; then
  extra_args+=("--volume=$bunfig:/home/node/.bunfig.toml:ro")
fi

# Prefer the krun runtime when available. It reads VM sizing from
# annotations rather than from --cpus/--memory.
if command -v krun >/dev/null; then
  extra_args+=(
    --runtime=krun
    "--annotation=krun.cpus=$NUM_CPUS"
    "--annotation=krun.ram_mib=$RAM_MB"
  )
fi

# Hardening matches bunc: no capabilities or setuid escalation, capped
# PIDs/CPU/RAM, host UID mapped through so /workspace files stay yours, and
# a read-only root fs where only /tmp, /workspace and ~/.claude are writable.
# The PID limit is higher than bunc's since the agent spawns many shells.
#
# Claude Code state:
#   - CLAUDE_CONFIG_DIR points at the named volume so that *all* state,
#     including .claude.json (normally written to $HOME, which is read-only
#     here), lands somewhere persistent.
#   - The auto-updater is disabled: it can't write to the read-only image
#     anyway, and upgrades happen by rebuilding the image.
#   - Prompt history isn't saved, so it doesn't accumulate in the volume.
#   - npm's cache goes to /tmp, since its default (~/.npm) is on the
#     read-only root fs.
#   - TERM is forwarded so colors and key handling match the host terminal.
#
# "${extra_args[@]+...}" avoids an "unbound variable" error under `set -u`
# on bash < 4.4 (e.g. macOS's /bin/bash) when the array is empty.
exec podman run \
  --rm \
  --interactive \
  --cap-drop=ALL \
  --security-opt=no-new-privileges \
  --pids-limit=1024 \
  --cpus="$NUM_CPUS" \
  --memory="${RAM_MB}m" \
  --userns=keep-id \
  --read-only \
  --tmpfs="/tmp:rw,nodev,nosuid,size=512m" \
  --volume="$cwd:$cwd" \
  --volume="claude-agent-home:/home/node/.claude:U" \
  --workdir="$cwd" \
  --env="CLAUDE_CONFIG_DIR=/home/node/.claude" \
  --env="DISABLE_AUTOUPDATER=1" \
  --env="npm_config_cache=/tmp/npm-cache" \
  --env="TERM=${TERM:-xterm-256color}" \
  "${extra_args[@]+"${extra_args[@]}"}" \
  "$CLAUDE_IMAGE_TAG" \
  "$@"
