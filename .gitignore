# Stow / setup artifacts
.dotfiles_installed

# OS and editor junk
.DS_Store
Thumbs.db
*.bak.*
*~
*.swp
*.swo
.idea/

# Secrets and local overrides
.env
.env.*
!.env.example
*.local.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
