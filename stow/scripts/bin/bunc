#!/usr/bin/env bash
set -euo pipefail

if ! command -v podman >/dev/null 2>&1; then
  echo "Error: podman is not installed. Please install podman to use this script." >&2
  exit 1
fi

BUN_VERSION="$(bun --version 2>/dev/null || true)"
BUN_DOCKER_IMAGE="docker.io/oven/bun:${BUN_VERSION:-1}-slim"

NUM_CPUS=4
MEMORY_MB=8192

podman_run_args=(
  --rm
  -it
  --cap-drop ALL
  --security-opt no-new-privileges
  --pids-limit 512
  --cpus "${NUM_CPUS}"
  --memory "${MEMORY_MB}m"
  --read-only
  --tmpfs "/tmp:rw,nosuid,nodev,mode=1777"
  --volume "${PWD}:${PWD}"
  --workdir "${PWD}"
  --userns keep-id
)

if [[ -f "${HOME}/.bunfig.toml" ]]; then
  podman_run_args+=(
    --volume "${HOME}/.bunfig.toml:/home/bun/.bunfig.toml:ro"
  )
fi

if command -v krun >/dev/null 2>&1; then
  podman_run_args+=(
    --runtime krun
    --annotation "krun.cpus=${NUM_CPUS}"
    --annotation "krun.ram_mib=${MEMORY_MB}"
  )
fi

if [[ $# -eq 0 ]]; then
  podman_run_args+=(
    --entrypoint bash
  )
else
  podman_run_args+=(
    --entrypoint bun
  )
fi

exec podman run "${podman_run_args[@]}" "${BUN_DOCKER_IMAGE}" "$@"
