#!/usr/bin/env bash
set -euo pipefail

# Create new executable bash scripts pre-populated with a standard header.
#
# Usage:
#   mkscript <file>...   Create each file with the header and chmod +x it.
#                        Existing files are never overwritten.

die() {
  printf 'mkscript: %s\n' "$*" >&2
  exit 1
}

create_script() {
  local file_path="$1"

  # -e (not -f) so directories and other non-regular files are also refused.
  [[ ! -e "$file_path" ]] || die "file already exists at $file_path"
  [[ -d "$(dirname -- "$file_path")" ]] || die "parent directory does not exist for $file_path"

  cat <<'EOF' >"$file_path"
#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

main() {
  echo "Hello, world! This script is located in $SCRIPT_DIR"
}

main "$@"
EOF

  chmod +x -- "$file_path"
  echo "Created bash script at $(readlink -f -- "$file_path")"
}

main() {
  [[ "$#" -gt 0 ]] || die "usage: mkscript <file>..."

  local file
  for file in "$@"; do
    create_script "$file"
  done
}

main "$@"
