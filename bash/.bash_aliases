# shellcheck shell=bash

# general
alias src='source "$HOME/.bashrc"'
alias ll="ls -la"
alias c="clear"

# apt (Debian/Ubuntu)
alias aptu="sudo apt update && sudo apt upgrade -y"
alias apti="sudo apt install"

# git
alias gs="git status"
alias gd="git diff"
alias ga="git add"
alias gf="git fetch"
alias gpl="git pull"
alias gaa="git add --all"
alias gcm="git commit -m"
alias gps="git push origin main"
