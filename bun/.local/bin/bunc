#!/usr/bin/env bash
#
# Run `bun` inside a locked-down, throwaway Podman container, with the
# current directory mounted at /workspace. All arguments are passed through
# to bun, e.g.:
#
#   ./bunc install
#   ./bunc run dev
#
# If krun (libkrun) is installed, the container runs inside a lightweight
# micro-VM for an extra isolation boundary beyond namespaces.

set -euo pipefail

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

command -v podman >/dev/null || die 'podman not found'

# Resource limits. Used both for Podman's cgroup limits and for sizing
# the krun VM, so the two stay in sync.
readonly NUM_CPUS=4
readonly RAM_MB=8192

# Match the host's bun version so lockfiles/behavior stay consistent.
# Falls back to the latest 1.x image when bun isn't installed locally.
host_bun_version="$(bun --version 2>/dev/null || true)"
readonly BUN_IMAGE="docker.io/oven/bun:${host_bun_version:-1}-slim"

extra_args=()

# Only allocate a TTY when we're actually attached to one; forcing --tty
# in pipes/CI corrupts output (CRLF line endings, merged stderr).
if [[ -t 0 && -t 1 ]]; then
  extra_args+=(--tty)
fi

# Expose the user's global bun config (registry, auth tokens, etc.)
# read-only. /home/bun is the home dir of the image's default user.
bunfig="$HOME/.bunfig.toml"
if [[ -f "$bunfig" ]]; then
  extra_args+=("--volume=$bunfig:/home/bun/.bunfig.toml:ro")
fi

# Prefer the krun runtime when available. It reads VM sizing from
# annotations rather than from --cpus/--memory.
if command -v krun >/dev/null; then
  extra_args+=(
    --runtime=krun
    "--annotation=krun.cpus=$NUM_CPUS"
    "--annotation=krun.ram_mib=$RAM_MB"
  )
fi

# Hardening, in order:
#   - no Linux capabilities, and no privilege escalation via setuid binaries
#   - cap process count (fork-bomb protection) plus CPU/RAM
#   - map the host user to the same UID inside, so files written to
#     /workspace are owned by you, not root or a subuid
#   - read-only root fs; only /tmp (size-capped) and /workspace are writable
#
# "${extra_args[@]+...}" avoids an "unbound variable" error under `set -u`
# on bash < 4.4 (e.g. macOS's /bin/bash) when the array is empty.
exec podman run \
  --rm \
  --interactive \
  --cap-drop=ALL \
  --security-opt=no-new-privileges \
  --pids-limit=512 \
  --cpus="$NUM_CPUS" \
  --memory="${RAM_MB}m" \
  --userns=keep-id \
  --read-only \
  --tmpfs="/tmp:rw,nodev,nosuid,size=512m" \
  --volume="$(pwd -P):/workspace" \
  --workdir=/workspace \
  "${extra_args[@]+"${extra_args[@]}"}" \
  "$BUN_IMAGE" \
  bun "$@"
