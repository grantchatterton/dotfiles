#!/usr/bin/env bash
set -euo pipefail

# Run Bun inside a locked-down Podman container, with only the current
# directory (and the global ~/.bunfig.toml, if present) visible to it.
#
# Usage:
#   bunc [<bun args>...]       Run `bun` with the given arguments in the sandbox.
#                              All arguments are passed straight through to bun.
#
# The image tag tracks the host's `bun --version` so the sandbox matches the
# host toolchain; it falls back to `latest` if bun is not on the host.

die() {
  printf 'bunc: %s\n' "$*" >&2
  exit 1
}

BUN_VERSION="$(bun --version 2>/dev/null || true)"
BUN_IMAGE="docker.io/oven/bun:${BUN_VERSION:-latest}-slim"
BUN_CONFIG="$HOME/.bunfig.toml"

# Sandbox resource limits.
NUM_CPUS=4
MEMORY_MB=8192

# The working directory is bind-mounted read-write at the same path, so
# refuse locations that would hand the process far more than one project.
cwd="$(pwd -P)"
if [[ "$cwd" == "/" || "$cwd" == "$(cd "$HOME" && pwd -P)" ]]; then
  die "refusing to mount $cwd into the sandbox; cd into a project first"
fi

declare -a podman_run_args=(
  --rm
  --interactive
  # Hardening: no privilege escalation, no capabilities, immutable root fs.
  --cap-drop all
  --security-opt no-new-privileges
  --read-only
  --tmpfs "/tmp:rw,nodev,nosuid,mode=1777"
  # Resource limits.
  --cpus "$NUM_CPUS"
  --memory "${MEMORY_MB}m"
  --pids-limit 512
  # Map the host user to the same UID inside so files written to the
  # project keep the right ownership.
  --userns keep-id
  --volume "$cwd:$cwd"
  --workdir "$cwd"
)

# Only allocate a TTY when attached to a terminal, so piping still works.
if [[ -t 0 && -t 1 ]]; then
  podman_run_args+=(--tty)
fi

# Prefer a libkrun micro-VM when available for stronger isolation. krun
# sizes the VM from annotations rather than the cgroup limits above.
if command -v krun >/dev/null; then
  podman_run_args+=(
    --runtime krun
    --annotation "krun.cpus=$NUM_CPUS"
    --annotation "krun.ram_mib=$MEMORY_MB"
  )
fi

# Share the host's global bunfig read-only so registry/install settings apply.
if [[ -f "$BUN_CONFIG" ]]; then
  podman_run_args+=(
    --volume "$BUN_CONFIG:/home/bun/$(basename -- "$BUN_CONFIG"):ro"
  )
fi

exec podman run "${podman_run_args[@]}" "$BUN_IMAGE" bun "$@"
