#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
BACKUP_FOLDER="$HOME/dotfiles-backup-$(date +%s)"

die() {
  printf '%s\n' "ERROR: $*" >&2
  exit 1
}

command -v stow >/dev/null || die "Stow not found"

cd -- "$SCRIPT_DIR"

packages=(*/)
for pkg in "${packages[@]}"; do
  [[ -d "$pkg" ]] || continue

  while IFS= read -r -d '' pkg_file; do
    pkg_file_rel="${pkg_file#"$pkg"}"
    pkg_file_home="$HOME/$pkg_file_rel"
    [[ -e "$pkg_file_home" ]] || continue

    pkg_file_home_backup="$BACKUP_FOLDER/$pkg_file_rel"
    mkdir -p -- "$(dirname -- "$pkg_file_home_backup")"

    cp -- "$pkg_file_home" "$pkg_file_home_backup"
    [[ -L "$pkg_file_home" ]] && ln -sfn -- "$(readlink -f -- "$pkg_file_home")" "$pkg_file_home_backup"

    rm -- "$pkg_file_home"
  done < <(find "$pkg" -type f -print0)
done

exec stow --no-folding -v -t ~ -- "${packages[@]}"
